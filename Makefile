PREFIX ?= /usr/local
CFLAGS ?= -O2 -Wall -Wextra
PROFILE ?= $(HOME)/.bashrc
INIT = eval "$$(autocomplete bash)"
# Bundled spec files (yaml + helper scripts), relative to specs/, any depth
SPEC_FILES := $(shell cd specs && find . \( -name '*.yaml' -o -name '*.js' -o -name '*.sh' \) | sed 's|^\./||' | sort)
SPEC_DIRS := $(sort $(filter-out ./,$(dir $(SPEC_FILES))))

autocomplete: autocomplete.c yaml.c yaml.h manparse.c manparse.h  ## Build the autocomplete binary
	$(CC) $(CFLAGS) -o $@ autocomplete.c yaml.c manparse.c

install: autocomplete  ## Install binary and specs, set up ~/.bashrc
	install -d $(PREFIX)/bin $(PREFIX)/share/autocomplete
	install -m 755 autocomplete $(PREFIX)/bin/autocomplete
	@for f in $(SPEC_FILES); do \
		install -d $(PREFIX)/share/autocomplete/$$(dirname $$f) && \
		install -m 644 specs/$$f $(PREFIX)/share/autocomplete/$$f || exit 1; \
	done
	@echo "installed $(words $(SPEC_FILES)) spec files to $(PREFIX)/share/autocomplete"
	@# skip under sudo: a root-owned ~/.cache would block later rebuilds
	@[ "$$(id -u)" = 0 ] || $(PREFIX)/bin/autocomplete cache
	@if grep -qF 'autocomplete bash' $(PROFILE) 2>/dev/null; then \
		echo "$(PROFILE): already set up"; \
	else \
		if [ -s $(PROFILE) ] && [ -n "$$(tail -c 1 $(PROFILE))" ]; then echo >> $(PROFILE); fi; \
		echo '$(INIT)' >> $(PROFILE); \
		echo '$(PROFILE): added $(INIT)'; \
	fi
	@# login shells (Terminal.app) read the first of these and never ~/.bashrc
	@if [ "$(PROFILE)" = "$(HOME)/.bashrc" ]; then \
		login=$(HOME)/.bash_profile; \
		for f in $(HOME)/.bash_profile $(HOME)/.bash_login $(HOME)/.profile; do \
			[ -e "$$f" ] && { login=$$f; break; }; \
		done; \
		if ! grep -qF '.bashrc' "$$login" 2>/dev/null; then \
			echo; \
			echo "Warning: $$login does not load ~/.bashrc, so new Terminal.app"; \
			echo "windows and tabs (login shells) won't get completion. Add this line to it:"; \
			echo; \
			echo '    [ -f ~/.bashrc ] && . ~/.bashrc'; \
		fi; \
	fi
	@bin=autocomplete; \
	[ "$$(command -v autocomplete)" = "$(PREFIX)/bin/autocomplete" ] || bin=$(PREFIX)/bin/autocomplete; \
	cmd="eval \"\$$($$bin bash)\""; \
	echo; \
	echo "autocomplete is installed. New terminals will load it automatically."; \
	note=; \
	if command -v pbcopy >/dev/null 2>&1 && printf '%s' "$$cmd" | pbcopy 2>/dev/null; then \
		note="This command is already in your clipboard, so just paste it and press Enter."; \
	fi; \
	echo "To enable it in this terminal right away, run:"; \
	echo; \
	echo "    $$cmd"; \
	echo; \
	[ -z "$$note" ] || { echo "$$note"; echo; }

# Removes only what install added: the binary, our bundled specs, and the
# exact init line (~/.config/autocomplete is left alone).
uninstall:  ## Remove everything install added
	rm -f $(addprefix $${XDG_CACHE_HOME:-$(HOME)/.cache}/autocomplete/,$(patsubst %.yaml,%.cache,$(notdir $(filter %.yaml,$(SPEC_FILES)))))
	rm -f $(PREFIX)/bin/autocomplete
	rm -f $(addprefix $(PREFIX)/share/autocomplete/,$(SPEC_FILES))
	rmdir $(addprefix $(PREFIX)/share/autocomplete/,$(SPEC_DIRS)) $(PREFIX)/share/autocomplete 2>/dev/null || true
	@if grep -qxF '$(INIT)' $(PROFILE) 2>/dev/null; then \
		sed -i '' '/^eval "\$$(autocomplete bash)"$$/d' $(PROFILE); \
		echo '$(PROFILE): removed $(INIT)'; \
	fi

# Precompile all visible specs into ~/.cache/autocomplete/<name>.cache
cache: autocomplete  ## Rebuild the spec cache
	./autocomplete cache

clean:  ## Delete the built binary
	rm -f autocomplete

LLMS_DOCS = README.md docs/adding-commands.md docs/writing-specs.md docs/man-pages.md \
	docs/troubleshooting.md docs/how-it-works.md docs/cache.md

llms-full.txt: $(LLMS_DOCS)  ## Regenerate llms-full.txt from README and docs
	@{ echo '# autocomplete (bash-autocomplete): full documentation'; echo; \
	  echo '> Generated by `make llms-full.txt` from README.md and docs/. Source: https://github.com/hza/bash-autocomplete'; \
	  for f in $(LLMS_DOCS); do echo; echo '---'; echo; echo "<!-- $$f -->"; echo; cat $$f; done; } > $@

.PHONY: install uninstall cache clean
