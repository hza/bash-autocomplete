PREFIX ?= /usr/local
CFLAGS ?= -O2 -Wall -Wextra
PROFILE ?= $(HOME)/.bashrc
INIT = eval "$$(autocomplete bash)"
# Init command for the current terminal: bare name if PATH resolves to the installed binary
INIT_BIN = $(if $(filter $(PREFIX)/bin/autocomplete,$(shell command -v autocomplete)),autocomplete,$(PREFIX)/bin/autocomplete)
INIT_CMD = eval "$$($(INIT_BIN) bash)"
# Bundled spec files (yaml + helper scripts), relative to specs/, any depth
SPEC_FILES := $(shell cd specs && find . \( -name '*.yaml' -o -name '*.js' -o -name '*.sh' \) | sed 's|^\./||' | sort)
SPEC_DIRS := $(sort $(filter-out ./,$(dir $(SPEC_FILES))))

SRCS := $(wildcard src/*.c)
HDRS := $(wildcard src/*.h)

autocomplete: $(SRCS) $(HDRS)  ## Build the autocomplete binary
	$(CC) $(CFLAGS) -o $@ $(SRCS)

install: autocomplete  ## Install binary and specs, set up ~/.bashrc
	install -d $(PREFIX)/bin $(PREFIX)/share/autocomplete
	install -m 755 autocomplete $(PREFIX)/bin/autocomplete
	@for f in $(SPEC_FILES); do \
		install -d $(PREFIX)/share/autocomplete/$$(dirname $$f) && \
		install -m 644 specs/$$f $(PREFIX)/share/autocomplete/$$f || exit 1; \
	done
	@echo "installed $(words $(SPEC_FILES)) spec files to $(PREFIX)/share/autocomplete"
	@if grep -qF 'autocomplete bash' $(PROFILE) 2>/dev/null; then \
		echo "$(PROFILE): already set up"; \
	else \
		if [ -s $(PROFILE) ] && [ -n "$$(tail -c 1 $(PROFILE))" ]; then echo >> $(PROFILE); fi; \
		echo '$(INIT)' >> $(PROFILE); \
		echo '$(PROFILE): added $(INIT)'; \
	fi
	@# login shells (Terminal.app) read the first of these and never ~/.bashrc
	@if [ "$(PROFILE)" = "$(HOME)/.bashrc" ]; then \
		login=$(HOME)/.bash_profile; \
		for f in $(HOME)/.bash_profile $(HOME)/.bash_login $(HOME)/.profile; do \
			[ -e "$$f" ] && { login=$$f; break; }; \
		done; \
		if ! grep -qF '.bashrc' "$$login" 2>/dev/null; then \
			echo; \
			echo "Warning: $$login does not load ~/.bashrc, so new Terminal.app"; \
			echo "windows and tabs (login shells) won't get completion. Add this line to it:"; \
			echo; \
			echo '    [ -f ~/.bashrc ] && . ~/.bashrc'; \
		fi; \
	fi
	@cmd='$(INIT_CMD)'; \
	echo; \
	echo "autocomplete is installed. New terminals will load it automatically."; \
	echo "To enable it in this terminal right away, run:"; \
	echo; \
	echo "    $$cmd"; \
	echo; \
	echo "(or run 'make pbcopy' to copy it to the clipboard)"; \
	echo

# Copies the init command for the current terminal to the clipboard (manual only)
pbcopy:  ## Copy the init command to the clipboard
	@printf '%s' '$(INIT_CMD)' | pbcopy && echo 'copied: $(INIT_CMD)'

# Removes only what install added: the binary, our bundled specs, and the
# exact init line (~/.config/autocomplete is left alone).
uninstall:  ## Remove everything install added
	rm -f $(PREFIX)/bin/autocomplete
	rm -f $(addprefix $(PREFIX)/share/autocomplete/,$(SPEC_FILES))
	rmdir $(addprefix $(PREFIX)/share/autocomplete/,$(SPEC_DIRS)) $(PREFIX)/share/autocomplete 2>/dev/null || true
	@if grep -qxF '$(INIT)' $(PROFILE) 2>/dev/null; then \
		sed -i '' '/^eval "\$$(autocomplete bash)"$$/d' $(PROFILE); \
		echo '$(PROFILE): removed $(INIT)'; \
	fi

# Release tarball dist/autocomplete-$(TARGET).tar.gz: bin/autocomplete + share/autocomplete/
# (the binary finds <bin dir>/../share/autocomplete). Used by CI and the Homebrew formula.
TARGET ?= $(shell uname -s | tr A-Z a-z)-$(shell uname -m)
dist: autocomplete  ## Build the release tarball dist/autocomplete-$(TARGET).tar.gz
	rm -rf dist/stage && install -d dist/stage/bin dist/stage/share/autocomplete
	install -m 755 autocomplete dist/stage/bin/autocomplete
	@for f in $(SPEC_FILES); do \
		install -d dist/stage/share/autocomplete/$$(dirname $$f) && \
		install -m 644 specs/$$f dist/stage/share/autocomplete/$$f || exit 1; \
	done
	install -m 644 LICENSE README.md dist/stage/
	tar -czf dist/autocomplete-$(TARGET).tar.gz -C dist/stage .
	rm -rf dist/stage

help:  ## List make targets
	@grep -E '^[a-zA-Z0-9_.-]+:.*## ' $(MAKEFILE_LIST) | sed 's/:.*## /\t/' | awk -F'\t' '{printf "  %-16s %s\n", $$1, $$2}'

# Plain '=' so an exported BASH (path of the shell) can't override it; BASH=5.0 on the command line does
BASH = 3.2
DOCKER_IMAGE ?= autocomplete:bash$(BASH)

docker-build:  ## Build the Linux test image (Alpine, bash 3.2; BASH=5.0 for another version)
	docker build --build-arg BASH=$(BASH) -t $(DOCKER_IMAGE) .

docker-run: docker-build  ## Rebuild and open an interactive bash shell in Docker (BASH=...)
	docker run --rm -it $(DOCKER_IMAGE)

clean:  ## Delete the built binary and dist/
	rm -rf autocomplete dist

LLMS_DOCS = README.md docs/adding-commands.md docs/writing-specs.md docs/generated-specs.md \
	docs/troubleshooting.md docs/how-it-works.md docs/cache.md

llms-full.txt: $(LLMS_DOCS)  ## Regenerate llms-full.txt from README and docs
	@{ echo '# autocomplete (bash-autocomplete): full documentation'; echo; \
	  echo '> Generated by `make llms-full.txt` from README.md and docs/. Source: https://github.com/hza/bash-autocomplete'; \
	  for f in $(LLMS_DOCS); do echo; echo '---'; echo; echo "<!-- $$f -->"; echo; cat $$f; done; } > $@

.PHONY: dist install uninstall clean pbcopy help docker-build docker-run
